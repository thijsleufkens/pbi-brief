# Kopieer naar deploy.env (staat in .gitignore) en vul in.
VPS="user@host"            # SSH-doel
PORT=22                    # SSH-poort
DEST="/opt/pbi-brief"      # installatiemap op de server
# Optioneel bij de eerste deploy: .env-regels POSTMARK_TOKEN/MAIL_FROM/MAIL_TO overnemen
# uit een bestaande .env op de server.
MAIL_BRON=""
# Optioneel: map voor heartbeat-bestanden (monitoring).
HEARTBEAT_DIR=""
# Endpoint van het taalmodel (OpenAI-compatibel).
QWEN_BASE_URL="http://127.0.0.1:8080/v1"
# Gebruiker waaronder de timers draaien.
RUN_USER="pbibrief"
# Optioneel: voorvoegsel voor de namen van de systemd-units (bijv. "mijnserver-").
UNIT_PREFIX=""
